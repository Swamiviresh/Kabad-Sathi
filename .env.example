# ─────────────────────────────────────────────────────────────────────
# Paste your OpenRouter API key after the "=" below, save, then restart:
#     npm run dev
# Get a key: https://openrouter.ai/keys
#
# This file is git-ignored. Never commit it.
# ─────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: Supabase (leave blank to use the local JSON database in data/db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: real SMS for OTP login. Without these, the OTP is shown on screen
# in demo mode so you can log in without an SMS account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_HASH_SECRET=change-me-in-production
