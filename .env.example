NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OTP login (optional) — without these, OTPs are logged to the server console and
# returned in the API response (devOtp) so you can demo without an SMS account.
# Pick ONE real provider to send actual SMS to a phone:

# Option A — Twilio (works worldwide, fastest to set up for a demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option B — MSG91 (India-focused, needs a DLT-registered template)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=KBDSTH
MSG91_TEMPLATE_ID=

OTP_HASH_SECRET=change-me-in-production

# AI features (optional) — without this, the AI Saathi assistant falls back to a small
# keyword-based command set and the photo scanner is disabled (manual entry still works).
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
